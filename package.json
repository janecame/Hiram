{
  "name": "hiram-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:fe": "npm run dev --workspace=frontend",
    "dev:be": "npm run dev --workspace=backend",
    "dev": "npm run dev:be & npm run dev:fe",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "test:fe": "npm run test --workspace=frontend",
    "test:be": "npm run test --workspace=backend"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.62.0"
  }
}
